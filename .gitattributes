# RAGE 2 Modding Toolkit - Git attributes
# Force LF line endings for consistency with the src/
# Binary files must never be normalized.

* text=auto eol=lf

# Text (source, docs, data)
*.cs      text eol=lf
*.csproj  text eol=lf
*.sln     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.xml     text eol=lf
*.config  text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.ps1     text eol=lf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary (never normalize)
*.exe     binary
*.dll     binary
*.pdb     binary
*.7z      binary
*.zip     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
