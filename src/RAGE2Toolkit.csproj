<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RAGE2Toolkit</AssemblyName>
    <RootNamespace>Rage2Toolkit</RootNamespace>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <Version>2.1.5</Version>
    <AssemblyVersion>2.1.5</AssemblyVersion>
    <FileVersion>2.1.5</FileVersion>
    <InformationalVersion>2.1.5</InformationalVersion>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>fragoneta.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <Optimize>true</Optimize>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <NoWarn>CS0162;CS0414;CS0219;CS0168</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Rage2Toolkit.cs" />
<Compile Include="UiPolish.cs" />
    <Compile Include="ExtractorOpt.cs" />
    <Compile Include="SingleExtractForm.cs" />
    <Compile Include="Repack.cs" />
    <Compile Include="TabFormat.cs" />
    <Compile Include="RepackerCore.cs" />
    <Compile Include="Wizards.cs" />
    <Compile Include="Updater.cs" />
    <Compile Include="CrashHandler.cs" />
    <Compile Include="Dialogs.cs" />
    <Compile Include="AssetConverters.cs" />
    <Compile Include="AssetValidators.cs" />    <Compile Include="ModMetadata.cs" />    <Compile Include="ModsStore.cs" />    <Compile Include="ModValidator.cs" />    <Compile Include="ModPackager.cs" />
    <Compile Include="ModInstaller.cs" />
    <Compile Include="ConflictChecker.cs" />
    <Compile Include="UninstallEngine.cs" />
    <Compile Include="ModManagerForm.cs" />
<Compile Include="ModMetaDialog.cs" />
<Compile Include="ModManagerHelpForm.cs" />
<Compile Include="GuidelinesHelpForm.cs" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>

    <Compile Include="SettingsEditorCore.cs" />

    <Compile Include="SettingsEditorForm.cs" />
    <Compile Include="SettingsIniEditorForm.cs" />

  </ItemGroup>

</Project>



